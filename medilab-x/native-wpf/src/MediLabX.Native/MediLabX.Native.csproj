<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediLabX.Native</AssemblyName>
    <RootNamespace>MediLabX.Native</RootNamespace>
    <Version>0.2.0-beta.1</Version>
    <ApplicationIcon Condition="Exists('Assets\MediLabX.ico')">Assets\MediLabX.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\imported-tests.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\MediLab-Heartbeat.png" />
  </ItemGroup>
</Project>